{
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/checkout",        "destination": "/checkout.html" },
    { "source": "/thank-you",       "destination": "/thank-you.html" },
    { "source": "/success",         "destination": "/success.html" },
    { "source": "/membership",      "destination": "/membership.html" },
    { "source": "/services",        "destination": "/services.html" },
    { "source": "/dashboard",       "destination": "/dashboard.html" },
    { "source": "/onboarding-assistant", "destination": "/onboarding-assistant.html" },
    { "source": "/ai-consulting",   "destination": "/ai-consulting.html" },
    { "source": "/ai-workshops",    "destination": "/ai-workshops.html" },
    { "source": "/automation",      "destination": "/automation.html" },
    { "source": "/crm-optimization","destination": "/crm-optimization.html" },
    { "source": "/systems-design",  "destination": "/systems-design.html" },
    { "source": "/retainer-support","destination": "/retainer-support.html" },
    { "source": "/partner-success", "destination": "/partner-success.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}

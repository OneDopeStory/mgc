# ================================================================
# MGC Global Consulting — Payment Hub Integration
# Copy to .env and fill in real values. NEVER commit .env.
# ================================================================

# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
HUB_SECRET=your_random_32_char_hub_secret_here

# ── QuickBooks ──────────────────────────────────────────────────
QB_CLIENT_ID=your_quickbooks_client_id
QB_CLIENT_SECRET=your_quickbooks_client_secret
QB_REFRESH_TOKEN=your_quickbooks_refresh_token
QB_REALM_ID=your_quickbooks_company_realm_id
QB_ENVIRONMENT=production
# Webhook verifier token — set in QB developer portal
QB_WEBHOOK_VERIFIER_TOKEN=your_qb_webhook_verifier_token

# ── Google Sheets ────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Base64-encoded JSON of the service account key file
# Run: base64 -i service-account-key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_B64=your_base64_encoded_key
GOOGLE_SHEETS_PAYMENT_SPREADSHEET_ID=your_payment_sheet_id
GOOGLE_SHEETS_INTEGRATIONS_SPREADSHEET_ID=your_integrations_sheet_id
# Tab/sheet name within the Payment spreadsheet
GOOGLE_SHEETS_PAYMENT_TAB=Payments
# Tab/sheet name within the Integrations spreadsheet
GOOGLE_SHEETS_INTEGRATIONS_TAB=Payment Log

# ── Slack ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_PAYMENTS_CHANNEL=#payments

# ── WhatsApp (Twilio) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Default fallback — overridden by customer phone from QB invoice
MGC_ADMIN_WHATSAPP=whatsapp:+1XXXXXXXXXX

# ── Notion ───────────────────────────────────────────────────────
NOTION_API_KEY=secret_your_notion_integration_key
NOTION_CLIENTS_DATABASE_ID=your_notion_clients_database_id
# Property names in your Notion DB (adjust to match your schema)
NOTION_STATUS_PROPERTY=Status
NOTION_EMAIL_PROPERTY=Email
NOTION_PAID_STATUS_VALUE=Paid

# ── Frontend (Success Motion trigger) ───────────────────────────
# URL of the MGC site page to POST the success event to
FRONTEND_SUCCESS_WEBHOOK_URL=https://mgcglobalconsulting.com/api/payment-success
FRONTEND_SUCCESS_SECRET=your_frontend_success_secret
